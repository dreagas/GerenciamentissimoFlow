# Copy to .env locally (ignored by Git) and replace every placeholder.
# Use independent random values; never reuse production credentials.
SPRING_PROFILES_ACTIVE=demo
POSTGRES_DB=gerenciamentissimoflow_demo
POSTGRES_USER=gerenciamentissimoflow_demo
POSTGRES_PASSWORD=<replace-with-local-database-password>
POSTGRES_PORT=55432
APP_PORT=18080
DB_URL=jdbc:postgresql://localhost:55432/${POSTGRES_DB}
DB_USERNAME=${POSTGRES_USER}
DB_PASSWORD=<replace-with-local-database-password>
JWT_SECRET=<generate-at-least-32-random-bytes>
DEMO_ADMIN_EMAIL=demo-admin@example.invalid
DEMO_ADMIN_PASSWORD=<generate-random-demo-password-minimum-16-characters>
CORS_ALLOWED_ORIGINS=http://localhost:3000
